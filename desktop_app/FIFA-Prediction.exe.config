<?xml version="1.0" encoding="utf-8"?>
<!--
  Copied next to FIFA-Prediction.exe by build_release.py. A zip downloaded
  from the internet and extracted with Windows Explorer marks every extracted
  file as "from the internet" (Zone.Identifier), and .NET Framework then
  refuses to load the bundled managed DLLs (pythonnet's Python.Runtime.dll,
  WebView2's .NET wrappers), so the app fails at startup with
  "Failed to resolve Python.Runtime.Loader.Initialize". This setting lets
  .NET load them anyway.
-->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
