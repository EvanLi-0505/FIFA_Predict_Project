# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Node / frontend (added when frontend/ exists)
node_modules/
dist/

# Environment / secrets
.env
*.env.local

# Trained model artifacts (large binaries) — the production artifact is
# committed under models/decision_tree/v1/ intentionally; ad-hoc retraining
# output elsewhere should not be.
/models/**/model.joblib
!/models/decision_tree/v1/model.joblib
!/models/logistic_regression/elo_v1/model.joblib

# User-uploaded datasets / generated SQLite DB (desktop dev runs)
/datasets/user/
dev-data/
# desktop_app/main.py in dev mode keeps its portable data (and the Settings
# log-folder pointer) next to the project root
/data/
/log_folder.txt
*.db
*.sqlite3

# Desktop (pywebview + PyInstaller) build artifacts — all regenerated by
# desktop_app/build_release.py, never hand-edited.
/desktop_app/build/
/desktop_app/release/
# NOT desktop_app/icon.ico — that's the committed icon source asset.

# Local-only materials (coursework, original notebook, development brief,
# icon source images) — kept on disk, never pushed.
/LocalOnly/

# Editor / tool state
.idea/
.claude/

# OS
.DS_Store
Thumbs.db
